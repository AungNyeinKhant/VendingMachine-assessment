# Dependencies & build output (rebuilt inside the image)
vendor/
node_modules/
public/build/
public/hot
resources/js/actions/
resources/js/routes/
resources/js/wayfinder/

# Local caches — packages.php lists dev-only providers (Boost, Pail) that
# don't exist in a --no-dev install and would break the app at boot.
bootstrap/cache/*.php
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
storage/*.key

# Secrets & local config
.env
.env.*
!.env.example
auth.json

# Tooling not needed at runtime
.git/
.github/
.idea/
.vscode/
.ai/
.claude/
.agents/
.mcp.json
AGENTS.md
CLAUDE.md
boost.json
opencode.json
tests/
phpunit.xml
.phpunit.cache
docs/
*.md
docker-compose*.yml
compose.yaml
Dockerfile
.dockerignore
.DS_Store
Thumbs.db
